# Copy to .env before `docker compose up`. Never commit a filled in .env.

APP_ENVIRONMENT=production
APP_WEB_PORT=8080

# --- Identity -----------------------------------------------------------------
# Replace with a long random value, for example `openssl rand -hex 32`.
APP_JWT_SECRET=change-me-in-production
APP_ACCESS_TOKEN_MINUTES=720
# Company single sign on (recommended for production).
# APP_OIDC_ISSUER=https://login.company.local/realms/company
# APP_OIDC_CLIENT_ID=ai-analysis-team
# APP_OIDC_CLIENT_SECRET=

# --- Persistence --------------------------------------------------------------
APP_MONGO_DB=ai_analysis_team

# --- Object storage (company hosted) ------------------------------------------
APP_S3_BUCKET=ai-analysis-team
APP_S3_ACCESS_KEY=minioadmin
APP_S3_SECRET_KEY=change-me-in-production

# --- AI gateway ---------------------------------------------------------------
# Cloud is disabled by default for the whole deployment. A project may be
# stricter than this setting, never looser.
APP_CLOUD_ENABLED_GLOBALLY=false
APP_CLOUD_PROVIDER=none
# APP_CLOUD_API_KEY=
# APP_CLOUD_MODEL=claude-sonnet-5

# Local inference. Without it the deterministic local analyst is used, which
# needs no model weights and produces transparent rule based output.
# APP_LOCAL_INFERENCE_URL=http://inference:11434/v1
APP_DEFAULT_LOCAL_MODEL=local/analysis-7b

# --- Delivery defaults --------------------------------------------------------
APP_DEFAULT_HOURS_PER_PERSON_DAY=8
APP_DEFAULT_CURRENCY=EUR
APP_DEFAULT_TIMEZONE=Europe/Athens
APP_CALIBRATION_MIN_COHORT=30

# --- Limits -------------------------------------------------------------------
APP_MAX_DOCUMENT_BYTES=104857600
APP_MAX_RECORDING_BYTES=2147483648

# --- Workers ------------------------------------------------------------------
APP_WORKER_CONCURRENCY=2
